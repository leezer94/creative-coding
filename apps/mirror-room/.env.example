# Copy to `.env.local` for development.

# HTTPS origin for QR / guest links. On localhost dev, use your Mac LAN IP:
#   ipconfig getifaddr en0
VITE_PUBLIC_ORIGIN=https://192.168.0.42:5173

# --- Production static deploy (build time) ---
# Required when running `pnpm --filter mirror-room build` for Netlify/Vercel/etc.
# Must be a public wss:// URL (reverse proxy, tunnel, or hosted signal).
# VITE_PUBLIC_ORIGIN=https://mirror.example.com
# VITE_SIGNAL_URL=wss://signal.example.com

# Optional dev override — skip Vite WSS proxy and hit signal directly:
# VITE_SIGNAL_URL=wss://192.168.0.42:8787

# Optional TURN (JSON array of RTCIceServer)
# VITE_ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"}]'

# --- LiveKit SFU (optional; see docs/architecture/mirror-room-livekit.md) ---
# VITE_USE_SFU=true
# VITE_LIVEKIT_URL=wss://your-project.livekit.cloud
# VITE_LIVEKIT_TOKEN_URL=https://your-site.netlify.app/.netlify/functions/livekit-token
# 게스트 무대에서 호스트 영상을 최고 레이어로(대역↑). 기본은 DPR 반영만.
# VITE_LIVEKIT_REMOTE_FULL_QUALITY=true

# Phase 3: microphone (host + guest)
# VITE_STAGE_AUDIO=true

# Optional: outbound video max bitrate (bps), P2P + LiveKit publish. Default ~2.8M.
# VITE_VIDEO_MAX_BITRATE=3500000
