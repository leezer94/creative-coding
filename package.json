{
  "name": "creative-coding",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.12.3",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/sync-mediapipe-public.mjs --app-dir apps/viscous-memory --app-dir apps/mirror-room",
    "dev": "turbo run dev",
    "dev:viscous-memory": "pnpm --filter viscous-memory dev",
    "dev:mirror-room": "pnpm --filter mirror-room dev",
    "dev:mirror-room-signal": "pnpm --filter mirror-room-signal start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "turbo run preview",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "catalog:",
    "@types/p5": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/three": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.4.2",
    "turbo": "^2.5.4",
    "typescript": "catalog:",
    "typescript-eslint": "^8.56.1",
    "vite": "catalog:"
  },
  "lint-staged": {
    "*.{js,ts,tsx,json,css,md}": [
      "prettier --write"
    ],
    "*.{js,ts,tsx}": [
      "eslint --fix"
    ]
  }
}
